+bool PollAnyDeviceInput(std::string_view input_name, double threshold = 0.5)
+{
+  if (!Host_RendererHasFocus() || !g_controller_interface.IsInit())
+    return false;
+  for (const auto& dev : g_controller_interface.GetAllDevices())
+  {
+    if (!dev)
+      continue;
+    if (auto* inp = dev->FindInput(input_name))
+    {
+      if (inp->GetState() > threshold)
+        return true;
+    }
+  }
+  return false;
+}
+
+void DrawTurbulenceOptionsMenu(float scale)
+{
+  static bool s_prev_toggle = false;
+  static bool s_prev_up = false;
+  static bool s_prev_down = false;
+  static bool s_prev_left = false;
+  static bool s_prev_right = false;
+  static bool s_prev_confirm = false;
+  static bool s_prev_cancel = false;
+  static int s_selected_row = 0;
+  static bool s_confirm_exit_open = false;
+  static int s_confirm_exit_choice = 0;  // 0 = No (Left), 1 = Yes (Right)
+
+  const bool has_focus = Host_RendererHasFocus();
+
+  // Poll R1 (Shoulder R) on any controller, or Tab / F1 on keyboard (only when focused)
+  const bool toggle_down =
+      has_focus && (PollAnyDeviceInput("Shoulder R") || PollAnyDeviceInput("Tab") ||
+                    PollAnyDeviceInput("F1") || ImGui::IsKeyDown(ImGuiKey_Tab));
+  if (toggle_down && !s_prev_toggle)
+  {
+    g_turbulence_menu_open = !g_turbulence_menu_open;
+    if (!g_turbulence_menu_open)
+      s_confirm_exit_open = false;
+  }
+  s_prev_toggle = toggle_down;
+
+  const ImVec2 display_size = ImGui::GetIO().DisplaySize;
+  if (display_size.x <= 0.0f || display_size.y <= 0.0f)
+    return;
+
+  // Subtle top-left badge when closed so user can verify R1 menu is active
+  if (!g_turbulence_menu_open)
+  {
+    ImGui::SetNextWindowPos(ImVec2(14.0f * scale, 14.0f * scale), ImGuiCond_Always);
+    ImGui::SetNextWindowBgAlpha(0.45f);
+    if (ImGui::Begin("##TurbulenceBadge", nullptr,
+                     ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoInputs |
+                         ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoSavedSettings |
+                         ImGuiWindowFlags_NoScrollbar | ImGuiWindowFlags_NoNav |
+                         ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoFocusOnAppearing))
+    {
+      ImGui::TextColored(ImVec4(0.55f, 0.85f, 1.0f, 0.95f), "[R1 / Tab] Turbulence Options");
+    }
+    ImGui::End();
+    return;
+  }
+
+  // Poll controller navigation when menu is open and window is focused
+  const bool up_down =
+      has_focus && (PollAnyDeviceInput("Pad N") || PollAnyDeviceInput("Left Y+", 0.55) ||
+                    PollAnyDeviceInput("Up Arrow") || ImGui::IsKeyDown(ImGuiKey_UpArrow));
+  const bool down_down =
+      has_focus && (PollAnyDeviceInput("Pad S") || PollAnyDeviceInput("Left Y-", 0.55) ||
+                    PollAnyDeviceInput("Down Arrow") || ImGui::IsKeyDown(ImGuiKey_DownArrow));
+  const bool left_down =
+      has_focus && (PollAnyDeviceInput("Pad W") || PollAnyDeviceInput("Left X-", 0.55) ||
+                    PollAnyDeviceInput("Left Arrow") || ImGui::IsKeyDown(ImGuiKey_LeftArrow));
+  const bool right_down =
+      has_focus && (PollAnyDeviceInput("Pad E") || PollAnyDeviceInput("Left X+", 0.55) ||
+                    PollAnyDeviceInput("Right Arrow") || ImGui::IsKeyDown(ImGuiKey_RightArrow));
+  const bool confirm_down =
+      has_focus && (PollAnyDeviceInput("Button S") || PollAnyDeviceInput("Return") ||
+                    ImGui::IsKeyDown(ImGuiKey_Enter));
+  const bool cancel_down =
+      has_focus && (PollAnyDeviceInput("Button E") || PollAnyDeviceInput("Escape") ||
+                    ImGui::IsKeyDown(ImGuiKey_Escape));
+
+  const bool nav_up = up_down && !s_prev_up;
+  const bool nav_down = down_down && !s_prev_down;
+  const bool nav_left = left_down && !s_prev_left;
+  const bool nav_right = right_down && !s_prev_right;
+  const bool nav_confirm = confirm_down && !s_prev_confirm;
+  const bool nav_cancel = cancel_down && !s_prev_cancel;
+
+  s_prev_up = up_down;
+  s_prev_down = down_down;
+  s_prev_left = left_down;
+  s_prev_right = right_down;
+  s_prev_confirm = confirm_down;
+  s_prev_cancel = cancel_down;
+
+  auto TriggerExitGame = []() {
+    Host_Message(HostMessageID::WMUserStop);
+    std::exit(0);
+  };
+
+  if (s_confirm_exit_open)
+  {
+    if (nav_cancel)
+    {
+      s_confirm_exit_open = false;
+    }
+    else
+    {
+      if (nav_left)
+        s_confirm_exit_choice = 0;  // No (Left)
+      if (nav_right)
+        s_confirm_exit_choice = 1;  // Yes (Right)
+      if (nav_confirm)
+      {
+        if (s_confirm_exit_choice == 1)
+          TriggerExitGame();
+        else
+          s_confirm_exit_open = false;
+      }
+    }
+  }
+  else
+  {
+    if (nav_cancel)
+    {
+      g_turbulence_menu_open = false;
+      return;
+    }
+
+    constexpr int kNumRows = 5;
+    if (nav_up)
+      s_selected_row = (s_selected_row + kNumRows - 1) % kNumRows;
+    if (nav_down)
+      s_selected_row = (s_selected_row + 1) % kNumRows;
+  }
+
+  // Resolution Scale options
+  struct ResOption
+  {
+    int scale;
+    const char* label;
+  };
+  static constexpr ResOption kResOptions[] = {
+      {1, "1x Native (640x528)"},   {2, "2x 720p (1280x1056)"},
+      {3, "3x 1080p (1920x1584)"},  {4, "4x 1440p (2560x2112)"},
+      {5, "5x (3200x2640)"},        {6, "6x 4K (3840x3168)"},
+  };
+  constexpr int kNumRes = static_cast<int>(std::size(kResOptions));
+  const int cur_scale = Config::Get(Config::GFX_EFB_SCALE);
+  int res_idx = 1;
+  for (int i = 0; i < kNumRes; ++i)
+  {
+    if (kResOptions[i].scale == cur_scale)
+    {
+      res_idx = i;
+      break;
+    }
+  }
+
+  // Aspect Ratio options
+  struct AspectOption
+  {
+    AspectMode mode;
+    const char* label;
+  };
+  static constexpr AspectOption kAspectOptions[] = {
+      {AspectMode::ForceWide, "16:9 (Widescreen)"},
+      {AspectMode::ForceStandard, "4:3 (Original)"},
+      {AspectMode::Auto, "Auto"},
+      {AspectMode::Stretch, "Stretch to Window"},
+  };
+  constexpr int kNumAspect = static_cast<int>(std::size(kAspectOptions));
+  const AspectMode cur_aspect = Config::Get(Config::GFX_ASPECT_RATIO);
+  int aspect_idx = 0;
+  for (int i = 0; i < kNumAspect; ++i)
+  {
+    if (kAspectOptions[i].mode == cur_aspect)
+    {
+      aspect_idx = i;
+      break;
+    }
+  }
+
+  auto ApplyResIdx = [&](int idx) {
+    idx = (idx + kNumRes) % kNumRes;
+    Config::SetBaseOrCurrent(Config::GFX_EFB_SCALE, kResOptions[idx].scale);
+  };
+
+  auto ApplyAspectIdx = [&](int idx) {
+    idx = (idx + kNumAspect) % kNumAspect;
+    const AspectMode mode = kAspectOptions[idx].mode;
+    Config::SetBaseOrCurrent(Config::GFX_ASPECT_RATIO, mode);
+    Config::SetBaseOrCurrent(Config::GFX_WIDESCREEN_HACK, mode != AspectMode::ForceStandard);
+    Core::System::GetInstance().GetVertexShaderManager().dirty = true;
+  };
+
+  if (!s_confirm_exit_open)
+  {
+    // Apply gamepad left/right/confirm changes
+    const int delta = nav_right ? 1 : (nav_left ? -1 : (nav_confirm ? 1 : 0));
+    if (delta != 0)
+    {
+      if (s_selected_row == 0)
+        ApplyResIdx(res_idx + delta);
+      else if (s_selected_row == 1)
+        ApplyAspectIdx(aspect_idx + delta);
+      else if (s_selected_row == 2)
+      {
+        g_turbulence_hud_stretched = !g_turbulence_hud_stretched;
+        Core::System::GetInstance().GetVertexShaderManager().dirty = true;
+      }
+      else if (s_selected_row == 3)
+      {
+        g_turbulence_metal_hud_enabled = !g_turbulence_metal_hud_enabled;
+      }
+      else if (s_selected_row == 4 && nav_confirm)
+      {
+        s_confirm_exit_open = true;
+        s_confirm_exit_choice = 0;  // Default to No (Left)
+      }
+    }
+  }
+
+  ImGui::SetNextWindowPos(ImVec2(display_size.x * 0.5f, display_size.y * 0.5f), ImGuiCond_Always,
+                          ImVec2(0.5f, 0.5f));
+  ImGui::SetNextWindowSize(ImVec2(520.0f * scale, 0.0f), ImGuiCond_Always);
+  ImGui::SetNextWindowBgAlpha(0.92f);
+
+  ImGui::PushStyleColor(ImGuiCol_WindowBg, ImVec4(0.06f, 0.09f, 0.16f, 0.95f));
+  ImGui::PushStyleColor(ImGuiCol_Border, ImVec4(0.20f, 0.65f, 1.0f, 0.85f));
+  ImGui::PushStyleVar(ImGuiStyleVar_WindowBorderSize, 2.0f);
+  ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(20.0f * scale, 16.0f * scale));
+  ImGui::PushStyleVar(ImGuiStyleVar_ItemSpacing, ImVec2(10.0f * scale, 12.0f * scale));
+
+  if (ImGui::Begin("Turbulence Options (Sonic Riders Recomp)", &g_turbulence_menu_open,
+                   ImGuiWindowFlags_NoCollapse | ImGuiWindowFlags_NoResize |
+                       ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_AlwaysAutoResize))
+  {
+    if (s_confirm_exit_open)
+    {
+      ImGui::Spacing();
+      ImGui::TextColored(ImVec4(1.0f, 0.85f, 0.25f, 1.0f), "Are you sure?");
+      ImGui::TextColored(ImVec4(0.75f, 0.85f, 0.95f, 1.0f),
+                         "Select with Left / Right and press A / Cross to confirm:");
+      ImGui::Separator();
+      ImGui::Spacing();
+
+      // Left option: No (index 0)
+      const bool no_selected = (s_confirm_exit_choice == 0);
+      if (no_selected)
+      {
+        ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.20f, 0.55f, 0.90f, 1.0f));
+        ImGui::PushStyleColor(ImGuiCol_ButtonHovered, ImVec4(0.28f, 0.65f, 1.0f, 1.0f));
+      }
+      if (ImGui::Button(no_selected ? "> No <" : "  No  ", ImVec2(210.0f * scale, 38.0f * scale)))
+      {
+        s_confirm_exit_choice = 0;
+        s_confirm_exit_open = false;
+      }
+      if (no_selected)
+        ImGui::PopStyleColor(2);
+
+      ImGui::SameLine(0.0f, 36.0f * scale);
+
+      // Right option: Yes (index 1)
+      const bool yes_selected = (s_confirm_exit_choice == 1);
+      if (yes_selected)
+      {
+        ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.85f, 0.22f, 0.22f, 1.0f));
+        ImGui::PushStyleColor(ImGuiCol_ButtonHovered, ImVec4(0.95f, 0.30f, 0.30f, 1.0f));
+      }
+      if (ImGui::Button(yes_selected ? "> Yes <" : "  Yes  ", ImVec2(210.0f * scale, 38.0f * scale)))
+      {
+        s_confirm_exit_choice = 1;
+        TriggerExitGame();
+      }
+      if (yes_selected)
+        ImGui::PopStyleColor(2);
+
+      ImGui::Spacing();
+    }
+    else
+    {
+      ImGui::TextColored(ImVec4(0.45f, 0.85f, 1.0f, 1.0f),
+                         "Use D-Pad / Left Stick or Mouse  |  [R1 / B / Circle] Close");
+      ImGui::Separator();
+
+      auto DrawRowPrefix = [&](int row, const char* label) {
+        if (s_selected_row == row)
+          ImGui::TextColored(ImVec4(1.0f, 0.85f, 0.20f, 1.0f), "> %-22s", label);
+        else
+          ImGui::Text("  %-22s", label);
+        ImGui::SameLine(230.0f * scale);
+      };
+
+      // Row 0: Resolution Scale
+      DrawRowPrefix(0, "Resolution Scale:");
+      if (ImGui::Button("<##res"))
+      {
+        s_selected_row = 0;
+        ApplyResIdx(res_idx - 1);
+      }
+      ImGui::SameLine();
+      ImGui::TextColored(s_selected_row == 0 ? ImVec4(1.0f, 0.9f, 0.3f, 1.0f) :
+                                               ImVec4(0.9f, 0.95f, 1.0f, 1.0f),
+                         "%-22s", kResOptions[res_idx].label);
+      ImGui::SameLine();
+      if (ImGui::Button(">##res"))
+      {
+        s_selected_row = 0;
+        ApplyResIdx(res_idx + 1);
+      }
+
+      // Row 1: Aspect Ratio
+      DrawRowPrefix(1, "Aspect Ratio:");
+      if (ImGui::Button("<##asp"))
+      {
+        s_selected_row = 1;
+        ApplyAspectIdx(aspect_idx - 1);
+      }
+      ImGui::SameLine();
+      ImGui::TextColored(s_selected_row == 1 ? ImVec4(1.0f, 0.9f, 0.3f, 1.0f) :
+                                               ImVec4(0.9f, 0.95f, 1.0f, 1.0f),
+                         "%-22s", kAspectOptions[aspect_idx].label);
+      ImGui::SameLine();
+      if (ImGui::Button(">##asp"))
+      {
+        s_selected_row = 1;
+        ApplyAspectIdx(aspect_idx + 1);
+      }
+
+      // Row 2: HUD Aspect Mode
+      DrawRowPrefix(2, "HUD Layout:");
+      if (ImGui::Button("<##hud"))
+      {
+        s_selected_row = 2;
+        g_turbulence_hud_stretched = !g_turbulence_hud_stretched;
+        Core::System::GetInstance().GetVertexShaderManager().dirty = true;
+      }
+      ImGui::SameLine();
+      ImGui::TextColored(s_selected_row == 2 ? ImVec4(1.0f, 0.9f, 0.3f, 1.0f) :
+                                               ImVec4(0.9f, 0.95f, 1.0f, 1.0f),
+                         "%-22s",
+                         g_turbulence_hud_stretched ? "Stretched (16:9)" : "Centered (4:3)");
+      ImGui::SameLine();
+      if (ImGui::Button(">##hud"))
+      {
+        s_selected_row = 2;
+        g_turbulence_hud_stretched = !g_turbulence_hud_stretched;
+        Core::System::GetInstance().GetVertexShaderManager().dirty = true;
+      }
+
+      // Row 3: Metal Performance HUD
+      DrawRowPrefix(3, "Metal HUD:");
+      if (ImGui::Button("<##mhud"))
+      {
+        s_selected_row = 3;
+        g_turbulence_metal_hud_enabled = !g_turbulence_metal_hud_enabled;
+      }
+      ImGui::SameLine();
+      ImGui::TextColored(g_turbulence_metal_hud_enabled ? ImVec4(0.35f, 1.0f, 0.55f, 1.0f) :
+                                                          ImVec4(0.85f, 0.45f, 0.45f, 1.0f),
+                         "%-22s", g_turbulence_metal_hud_enabled ? "Enabled (On)" : "Disabled (Off)");
+      ImGui::SameLine();
+      if (ImGui::Button(">##mhud"))
+      {
+        s_selected_row = 3;
+        g_turbulence_metal_hud_enabled = !g_turbulence_metal_hud_enabled;
+      }
+
+      ImGui::Separator();
+
+      // Row 4: Exit Game
+      DrawRowPrefix(4, "Exit Game:");
+      if (s_selected_row == 4)
+      {
+        ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.75f, 0.18f, 0.18f, 1.0f));
+        ImGui::PushStyleColor(ImGuiCol_ButtonHovered, ImVec4(0.90f, 0.25f, 0.25f, 1.0f));
+      }
+      if (ImGui::Button(s_selected_row == 4 ? "> Exit Game <" : "  Exit Game  ",
+                        ImVec2(230.0f * scale, 30.0f * scale)))
+      {
+        s_selected_row = 4;
+        s_confirm_exit_open = true;
+        s_confirm_exit_choice = 0;  // Default to No (Left)
+      }
+      if (s_selected_row == 4)
+        ImGui::PopStyleColor(2);
+    }
+  }
+  ImGui::End();
+
+  ImGui::PopStyleVar(3);
+  ImGui::PopStyleColor(2);
+}
