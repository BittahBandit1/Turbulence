diff --git a/Source/Core/VideoCommon/TurbulenceTriggerCaption.h b/Source/Core/VideoCommon/TurbulenceTriggerCaption.h
new file mode 100644
index 0000000..0691896
--- /dev/null
+++ b/Source/Core/VideoCommon/TurbulenceTriggerCaption.h
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include "VideoCommon/TurbulencePromptTextures.h"
+#include <span>
+#include <cstring>
+namespace TurbulencePromptTextures::Detail
+{
+inline std::string RecipePrefix(std::string base_name, const std::string& texture_hash)
+{
+  // The game can bind the same HUD atlas with mipmaps enabled or disabled.
+  // That changes Dolphin's name, not the layout of its button cells.
+  if (base_name.ends_with("_m"))
+    base_name.resize(base_name.size() - 2);
+  return base_name + "_" + texture_hash;
+}
+// Compact native-resolution lettering; reuse the original keycap frame and
+// transparency rather than substituting an unrelated controller icon style.
+inline std::array<u8, 7> TriggerGlyph(char c)
+{
+  switch (c)
+  {
+  case 'L': return {16, 16, 16, 16, 16, 16, 31};
+  case 'R': return {30, 17, 17, 30, 20, 18, 17};
+  case 'T': return {31, 4, 4, 4, 4, 4, 4};
+  case '2': return {14, 17, 1, 2, 4, 8, 31};
+  default: return {};
+  }
+}
+
+inline void CaptionTrigger(std::span<u8> rgba, u32 width, const CellCopy& cell,
+                    const std::string& label)
+{
+  if (label.size() != 2 || cell.width != 64 || cell.height != 64)
+    return;
+  const auto pixel = [&](u32 x, u32 y, u8 value) {
+    u8* p = &rgba[(size_t(cell.y + y) * width + cell.x + x) * 4];
+    p[0] = p[1] = p[2] = value;
+    p[3] = 255;
+  };
+  for (u32 y = 17; y < 50; ++y)
+    for (u32 x = 8; x < 56; ++x)
+      pixel(x, y, 0);
+  constexpr u32 scale = 3;
+  for (u32 character = 0; character < 2; ++character)
+  {
+    const auto glyph = TriggerGlyph(label[character]);
+    for (u32 y = 0; y < glyph.size(); ++y)
+      for (u32 x = 0; x < 5; ++x)
+        if (glyph[y] & (1u << (4 - x)))
+          for (u32 sy = 0; sy < scale; ++sy)
+            for (u32 sx = 0; sx < scale; ++sx)
+              pixel(15 + character * 18 + x * scale + sx, 23 + y * scale + sy, 224);
+  }
+}
+
+// Read every source cell from the immutable decoded atlas: source cells may
+// overlap another destination, particularly the stick and trigger keycaps.
+inline void ApplyCells(std::span<u8> rgba, u32 width, u32 height,
+                       std::span<const u8> decoded, u32 source_stride,
+                       const Recipe& recipe, Style style)
+{
+  if (style == GameCube || style < GameCube || style >= StyleCount ||
+      source_stride < width || rgba.size() < size_t(width) * height * 4 ||
+      decoded.size() < size_t(source_stride) * height * 4)
+    return;
+  for (const CellCopy& c : recipe.cells)
+  {
+    const u32 sx = c.source_x[style], sy = c.source_y[style];
+    if (c.x + c.width > width || c.y + c.height > height ||
+        sx + c.width > width || sy + c.height > height)
+      continue;
+    for (u32 row = 0; row < c.height; ++row)
+      std::memcpy(&rgba[(size_t(c.y + row) * width + c.x) * 4],
+                  &decoded[(size_t(sy + row) * source_stride + sx) * 4], size_t(c.width) * 4);
+    if (!c.labels[style].empty())
+      CaptionTrigger(rgba, width, c, c.labels[style]);
+  }
+}
+}  // namespace TurbulencePromptTextures::Detail
diff --git a/Source/Core/VideoCommon/TurbulenceViewport.h b/Source/Core/VideoCommon/TurbulenceViewport.h
new file mode 100644
index 0000000..d6e84c0
--- /dev/null
+++ b/Source/Core/VideoCommon/TurbulenceViewport.h
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <atomic>
+#include <bit>
+#include <cmath>
+#include <cstdint>
+
+namespace TurbulenceViewport
+{
+constexpr double OriginalAspect = 4.0 / 3.0;
+constexpr double Pi = 3.14159265358979323846;
+struct Scale
+{
+  float width = 1.0f;
+  float height = 1.0f;
+};
+inline std::atomic<std::uint64_t> scale_bits{std::bit_cast<std::uint64_t>(Scale{})};
+inline std::atomic<bool> camera_adjusted{false};
+
+inline void PublishScale(float width, float height)
+{
+  scale_bits.store(std::bit_cast<std::uint64_t>(Scale{width, height}), std::memory_order_relaxed);
+}
+inline Scale ReadScale()
+{
+  return std::bit_cast<Scale>(scale_bits.load(std::memory_order_relaxed));
+}
+
+inline bool IsFullscreenBackground(float left, float right, float top, float bottom,
+                                   std::uint32_t vertices)
+{
+  constexpr float edge = 0.05f;
+  return vertices == 4 && left <= -1.0f + edge && right >= 1.0f - edge &&
+         top <= -1.0f + edge && bottom >= 1.0f - edge;
+}
+
+// The game's perspective wrapper takes aspect in f1 and vertical FOV in
+// 65536 units per turn in r4. Use the SAME Hor+/Vert+ view as the renderer,
+// but construct it in guest RAM so the game's frustum tests see it too.
+inline bool AdjustCamera(double& aspect, std::uint32_t& fov, Scale scale)
+{
+  if (!std::isfinite(aspect) || std::abs(aspect - OriginalAspect) > 0.01 ||
+      !std::isfinite(scale.width) || !std::isfinite(scale.height) ||
+      scale.width <= 0 || scale.height <= 0 || fov == 0 || fov >= 32768 ||
+      (scale.width == 1.0f && scale.height == 1.0f))
+    return false;
+  aspect *= scale.height / scale.width;
+  if (scale.height != 1.0f)
+  {
+    const double half_angle = fov * Pi / 65536.0;
+    fov = static_cast<std::uint32_t>(std::lround(std::atan(std::tan(half_angle) / scale.height) *
+                                               65536.0 / Pi));
+  }
+  return true;
+}
+
+inline bool ProjectionAlreadyAdjusted(float x_scale, float y_scale, Scale scale)
+{
+  if (!camera_adjusted.load(std::memory_order_relaxed) || x_scale == 0.0f)
+    return false;
+  const double expected = OriginalAspect * scale.height / scale.width;
+  return std::isfinite(expected) &&
+         std::abs(std::abs(y_scale / x_scale) - expected) < expected * 0.005;
+}
+}  // namespace TurbulenceViewport
