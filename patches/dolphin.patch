@@ -0,0 +1,18 @@
+// Turbulence: dispatcher for the recompiled REL (e.g. Sonic Riders' _Main.rel).
+//
+// DolRecomp writes a REL as its own output with its own generated.h, whose
+// static inline dispatcher only knows the REL's chunks. This translation unit
+// is compiled against that header, so the module can try the DOL's dispatcher
+// first and fall through to the REL's.
+
+#include "generated.h"
+
+int turbulence_rel_call(CPUState* ctx, u32 address)
+{
+    return dolrecomp_call(ctx, address);
+}
+
+u32 turbulence_rel_entry_point(void)
+{
+    return DOLRECOMP_ENTRY_POINT;
+}
