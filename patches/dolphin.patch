+void PreferPerformanceCores(const char* role)
+{
+  // Rank cores by the scheduler's own capacity (efficiency cores are lowest).
+  cpu_set_t allowed;
+  CPU_ZERO(&allowed);
+  if (sched_getaffinity(0, sizeof(allowed), &allowed) != 0)
+    return;
+  int capacity[CPU_SETSIZE] = {};
+  int lowest = 1 << 30, highest = 0;
+  const int count = std::min<int>(sysconf(_SC_NPROCESSORS_CONF), CPU_SETSIZE);
+  for (int cpu = 0; cpu < count; ++cpu)
+  {
+    char path[64];
+    std::snprintf(path, sizeof(path), "/sys/devices/system/cpu/cpu%d/cpu_capacity", cpu);
+    if (FILE* file = std::fopen(path, "r"))
+    {
+      if (std::fscanf(file, "%d", &capacity[cpu]) != 1)
+        capacity[cpu] = 0;
+      std::fclose(file);
+    }
+    if (capacity[cpu] > 0)
+    {
+      lowest = std::min(lowest, capacity[cpu]);
+      highest = std::max(highest, capacity[cpu]);
+    }
+  }
+  if (highest <= lowest)
+    return;  // Unknown or uniform cores: leave scheduling alone.
+  cpu_set_t fast;
+  CPU_ZERO(&fast);
+  std::string list;
+  for (int cpu = 0; cpu < count; ++cpu)
+  {
+    if (CPU_ISSET(cpu, &allowed) && capacity[cpu] > lowest)
+    {
+      CPU_SET(cpu, &fast);
+      list += (list.empty() ? "" : ",") + std::to_string(cpu);
+    }
+  }
+  if (list.empty())
+    return;
+  const int result = sched_setaffinity(0, sizeof(fast), &fast);
+  std::fprintf(stderr, "[turbulence] %s thread (tid %d) on cores %s%s\n", role, int(gettid()),
+               list.c_str(), result == 0 ? "" : " (failed)");
+}
+#else
+void PreferPerformanceCores(const char*)
+{
+}
+#endif
