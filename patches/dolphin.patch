+void Metal::Gfx::FlushBeforePresentationWait()
+{
+  // Keep GPU execution ahead of the host deadline instead of submitting the
+  // entire frame after the timer wakes. Presentation is queued separately on
+  // the same command queue, so it still follows all rendering of this drawable.
+  static const bool enabled = [] {
+    const char* value = std::getenv("TURBULENCE_EARLY_SUBMIT");
+    return !value || *value != '0';
+  }();
+  if (enabled && m_drawable)
+  {
+    Flush();
+    TurbulencePresentTimes::Get().early_render_submits.fetch_add(1, std::memory_order_relaxed);
+  }
+}
