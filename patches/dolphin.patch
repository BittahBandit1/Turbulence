diff --git a/Source/Core/VideoCommon/TurbulencePresentTimes.h b/Source/Core/VideoCommon/TurbulencePresentTimes.h
new file mode 100644
index 0000000..1c6b83d
--- /dev/null
+++ b/Source/Core/VideoCommon/TurbulencePresentTimes.h
@@ -0,0 +1,42 @@
+// Turbulence diagnostic (from ReFare): on-glass present times reported by the
+// video backend (Metal: MTLDrawable.presentedTime, host-clock seconds; 0 when
+// a frame was dropped). Ring published by presentation callbacks,
+// read by the frame pacing recorder.
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+
+namespace TurbulencePresentTimes
+{
+struct Ring
+{
+  std::mutex producers;
+  std::array<std::atomic<double>, 512> seconds{};
+  std::atomic<uint64_t> head{0};
+  std::atomic<double> drawable_wait_ms{0};
+  std::atomic<double> submit_ms{0};
+  std::atomic<uint64_t> drawable_requests{0};
+  std::atomic<uint64_t> drawable_failures{0};
+  std::atomic<uint64_t> early_render_submits{0};
+  std::atomic<double> clock_offset_seconds{0};
+};
+
+inline Ring& Get()
+{
+  static Ring ring;
+  return ring;
+}
+
+inline void Push(double presented_seconds)
+{
+  Ring& ring = Get();
+  // Drawable callbacks may be delivered from different driver threads.
+  std::lock_guard lock(ring.producers);
+  const uint64_t index = ring.head.load(std::memory_order_relaxed);
+  ring.seconds[index % ring.seconds.size()].store(presented_seconds, std::memory_order_relaxed);
+  ring.head.store(index + 1, std::memory_order_release);
+}
+}  // namespace TurbulencePresentTimes
