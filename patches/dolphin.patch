+# GXEE8P - Sonic Riders (USA)
 [Core]
-StaticRecompFallbackRanges = 0x8000ADE0-0x8000B5E0
+# Turbulence: the SDK cache routines at 0x8000ADE0-0x8000B5E0 (DCFlushRange,
+# ICInvalidateRange, ...) used to be forced into the interpreter -- over a
+# billion interpreted instructions per three minutes. The module's
+# cache-control hooks handle dcbf/dcbst/icbi natively; runs with this empty
+# keep 60 fps with every chunk verified and no SMC failures.
+StaticRecompFallbackRanges =
+
+# Verified SDK scheduler idle poll: ready queue is empty until an interrupt.
+# The runtime checks the instruction signature, queue bitmap and interrupt
+# state before advancing to the next scheduled event.
+StaticRecompIdlePC = 0x80010574
