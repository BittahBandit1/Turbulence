+      (g_turbulence_hud_stretched && g_turbulence_draw_2d.mode != TurbulenceDraw2D::Movie4x3 &&
+       g_turbulence_draw_2d.mode != TurbulenceDraw2D::AspectLockedArt))
+    return {};
+  const float w = g_ActiveConfig.fAspectRatioHackW, h = g_ActiveConfig.fAspectRatioHackH;
+  const TurbulenceDraw2D& d = g_turbulence_draw_2d;
