+void ClearMacOSKeyStates()
+{
+  std::memset(g_turbulence_macos_key_down, 0, sizeof(g_turbulence_macos_key_down));
+}
+
+bool AnyMacOSKeyDown()
+{
+  for (bool down : g_turbulence_macos_key_down)
+  {
+    if (down)
+      return true;
+  }
+  return false;
+}
+
+bool IsSpotlightOverlayActive()
+{
+  static auto s_last_check = std::chrono::steady_clock::now() - std::chrono::seconds(1);
+  static bool s_cached_active = false;
+
+  const auto now = std::chrono::steady_clock::now();
+  if (now - s_last_check < std::chrono::milliseconds(50))
+    return s_cached_active;
+  s_last_check = now;
+
+  bool active = false;
+  CFArrayRef window_list = CGWindowListCopyWindowInfo(
+      kCGWindowListOptionOnScreenOnly | kCGWindowListExcludeDesktopElements, kCGNullWindowID);
+  if (window_list)
+  {
+    const CFIndex count = CFArrayGetCount(window_list);
+    for (CFIndex i = 0; i < count; ++i)
+    {
+      auto dict = static_cast<CFDictionaryRef>(CFArrayGetValueAtIndex(window_list, i));
+      if (!dict)
+        continue;
+      auto owner = static_cast<CFStringRef>(CFDictionaryGetValue(dict, kCGWindowOwnerName));
+      if (!owner)
+        continue;
+      if (CFStringCompare(owner, CFSTR("Spotlight"), 0) == kCFCompareEqualTo)
+      {
+        int layer = 0;
+        if (auto layer_num = static_cast<CFNumberRef>(CFDictionaryGetValue(dict, kCGWindowLayer)))
+          CFNumberGetValue(layer_num, kCFNumberIntType, &layer);
+        // Spotlight's menubar icon lives in layer 25 with tiny height (~24px);
+        // the Spotlight search bar / results window has height >= 40px.
+        auto bounds_dict =
+            static_cast<CFDictionaryRef>(CFDictionaryGetValue(dict, kCGWindowBounds));
+        CGRect bounds = CGRectZero;
+        if (bounds_dict)
+          CGRectMakeWithDictionaryRepresentation(bounds_dict, &bounds);
+        if (bounds.size.height >= 40.0 && bounds.size.width >= 200.0)
+        {
+          active = true;
+          break;
+        }
+      }
+    }
+    CFRelease(window_list);
+  }
+  s_cached_active = active;
+  return active;
+}
+}  // namespace
