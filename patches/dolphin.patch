+    // Turbulence: the DOL's dispatcher first, then the recompiled REL's. This
+    // must also run after the x86-64-v3 copy, which only covers main.dol.
+    if (!handled)
+        handled = turbulence_rel_call(ctx, address);
+#endif
+    return handled;
 }
 
 void dolrecomp_indirect_dispatch(CPUState* ctx, u32 address)
@@ -104,6 +151,10 @@ static const StaticRecompModuleDesc s_desc = {
     s_chunk_ranges,
     MODULE_CHUNK_RANGE_COUNT,
     s_chunk_hashes,
+#if defined(MODULE_HAVE_REL)
+    s_rel_modules,
+    MODULE_REL_MODULE_COUNT,
+#endif
 };
 
