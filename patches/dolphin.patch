+bool VertexManagerBase::MeasureExtent(NativeVertexFormat* format, float* out_min, float* out_max,
+                                      float* out_min_y, float* out_max_y) const
+{
+  if (!format)
+    return false;
+  const PortableVertexDeclaration& decl = format->GetVertexDeclaration();
+  if (!decl.position.enable || decl.position.type != ComponentFormat::Float || decl.stride == 0)
+    return false;
+  // Only this draw's vertices. On Vulkan m_base_buffer_pointer is the start of
+  // the whole mapped stream buffer, so measuring from it walked up to 4096 stale
+  // vertices of earlier draws -- uncached GPU memory on AMD, 8 fps at character
+  // select on Windows -- and mixed their extents into this one.
+  const u8* const start = m_draw_start_pointer ? m_draw_start_pointer : m_base_buffer_pointer;
+  const u32 count = static_cast<u32>((m_cur_buffer_pointer - start) / decl.stride);
+  if (count == 0)
+    return false;
+  const auto& raw = xfmem.projection.rawProjection;  // ortho: x_clip = raw[0] * x + raw[1]
+  float min_x = 2.0f, max_x = -2.0f, min_y = 2.0f, max_y = -2.0f;
+  const u32 limit = std::min<u32>(count, 4096);
+  for (u32 i = 0; i < limit; ++i)
+  {
+    const u8* v = start + size_t(i) * decl.stride;
+    float p[3] = {0.0f, 0.0f, 0.0f};
+    std::memcpy(p, v + decl.position.offset, sizeof(float) * std::min(decl.position.components, 3));
+    u32 mtx = g_main_cp_state.matrix_index_a.PosNormalMtxIdx;
+    if (decl.posmtx.enable)
+      mtx = v[decl.posmtx.offset];
+    const float* m = &xfmem.posMatrices[(mtx & 0x3f) * 4];
+    const float x = raw[0] * (p[0] * m[0] + p[1] * m[1] + p[2] * m[2] + m[3]) + raw[1];
+    const float y = raw[2] * (p[0] * m[4] + p[1] * m[5] + p[2] * m[6] + m[7]) + raw[3];
+    min_y = std::min(min_y, y);
+    max_y = std::max(max_y, y);
+    min_x = std::min(min_x, x);
+    max_x = std::max(max_x, x);
+  }
+  // Diagnostic: TURBULENCE_WS_TRACE=1 logs the extent of 2D draws (once per
+  // distinct extent) to find full-width art that falls just short.
+  static const bool trace = [] {
+    const char* t = std::getenv("TURBULENCE_WS_TRACE");
+    return t && *t == '1';
+  }();
+  if (trace)
+  {
+    static std::set<std::pair<int, int>> seen;
+    const std::pair<int, int> key{int(min_x * 1000), int(max_x * 1000)};
+    if (seen.size() < 4000 && seen.insert(key).second)
+      std::fprintf(stderr, "[ws] 2D extent %.3f .. %.3f (%u vertices)\n", min_x, max_x, count);
+  }
+  *out_min_y = min_y;
+  *out_max_y = max_y;
+  *out_min = min_x;
+  *out_max = max_x;
+  return true;
+}
