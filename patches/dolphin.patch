diff --git a/Source/Core/VideoCommon/TurbulencePromptTextures.h b/Source/Core/VideoCommon/TurbulencePromptTextures.h
new file mode 100644
--- /dev/null
+++ b/Source/Core/VideoCommon/TurbulencePromptTextures.h
@@ -0,0 +1,70 @@
+// Turbulence: switch texture-baked button prompts between console styles
+// (generalised from ReFare's RefarePromptTextures).
+//
+// Sonic Riders' prompt textures already hold the GameCube, Xbox and
+// PlayStation 2 versions of each button icon side by side; the GameCube game
+// only draws the GameCube cells. The frontend registers recipes (which cells
+// to copy over the GameCube ones for each style). While a non-GameCube style
+// is active, a matching texture is decoded, patched and used instead; a style
+// change evicts matching cache entries so it shows on the next frame.
+#pragma once
+
+#include <memory>
+#include <array>
+#include <string>
+#include <vector>
+
+#include "Common/CommonTypes.h"
+
+class TextureInfo;
+namespace VideoCommon
+{
+class CustomTextureData;
+}
+
+namespace TurbulencePromptTextures
+{
+enum Style : int
+{
+  GameCube = 0,
+  Xbox = 1,
+  PlayStation = 2,
+  StyleCount = 3,
+};
+
+struct CellCopy
+{
+  // Destination: the GameCube cell. Sources: the same-size cell to copy for
+  // each style (index by Style; the GameCube entry is unused).
+  u32 x, y, width, height;
+  u32 source_x[StyleCount];
+  u32 source_y[StyleCount];
+  // Optional caption inside the game's rectangular trigger keycap. Used
+  // where this platform's label is absent from the original texture atlas.
+  std::array<std::string, StyleCount> labels{};
+};
+
+struct Recipe
+{
+  // Matches Dolphin's texture name without the palette hash, e.g.
+  // "tex1_256x128_af289750027e9b53" plus the GX format (9 = C8).
+  std::string name_prefix;
+  u32 gx_format;
+  std::vector<CellCopy> cells;
+};
+
+// Call before rendering starts.
+void Register(Recipe recipe);
+
+// Any thread. Takes effect on the next texture lookup.
+void SetStyle(Style style);
+
+// Video thread (texture cache): the patched texture for the current style.
+std::shared_ptr<VideoCommon::CustomTextureData> Find(const TextureInfo& texture_info);
+
+// Video thread: true once after each style change (evict prompt textures).
+bool TakeStyleChange();
+
+// Whether a texture of this size/format could be a registered prompt.
+bool MayMatch(u32 width, u32 height, u32 gx_format);
+}  // namespace TurbulencePromptTextures
