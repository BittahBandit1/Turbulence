diff --git a/module-template/rel_dispatch.c b/module-template/rel_dispatch.c
new file mode 100644
index 0000000..0fb1a8a
--- /dev/null
+++ b/module-template/rel_dispatch.c
@@ -0,0 +1,18 @@
+// Turbulence: dispatcher for the recompiled REL (e.g. Sonic Riders' _Main.rel).
+//
+// DolRecomp writes a REL as its own output with its own generated.h, whose
+// static inline dispatcher only knows the REL's chunks. This translation unit
+// is compiled against that header, so the module can try the DOL's dispatcher
+// first and fall through to the REL's.
+
+#include "generated.h"
+
+int turbulence_rel_call(CPUState* ctx, u32 address)
+{
+    return dolrecomp_call(ctx, address);
+}
+
+u32 turbulence_rel_entry_point(void)
+{
+    return DOLRECOMP_ENTRY_POINT;
+}
diff --git a/GXRuntime/include/core/psq_scale.h b/GXRuntime/include/core/psq_scale.h
new file mode 100644
index 0000000..8341fa5
--- /dev/null
+++ b/GXRuntime/include/core/psq_scale.h
@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+/* Exact GQR power-of-two factors. GQR scales are signed six-bit values;
+ * dequantization negates them, giving the inclusive range [-32, 32]. */
+#ifndef GXRUNTIME_PSQ_SCALE_H
+#define GXRUNTIME_PSQ_SCALE_H
+#include <stdint.h>
+#include <string.h>
+static inline float psq_scale_factor(int scale) {
+    const uint32_t bits = (uint32_t)(127 + scale) << 23;
+    float factor;
+    memcpy(&factor, &bits, sizeof(factor));
+    return factor;
+}
+#endif
diff --git a/Source/Core/AudioCommon/IOSSoundStream.mm b/Source/Core/AudioCommon/IOSSoundStream.mm
new file mode 100644
index 0000000..2f75521
--- /dev/null
+++ b/Source/Core/AudioCommon/IOSSoundStream.mm
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "AudioCommon/SoundStream.h"
+#include <AudioToolbox/AudioToolbox.h>
+#include <algorithm>
+#include <atomic>
+#include <cstring>
+
+namespace AudioCommon {
+namespace {
+class IOSSoundStream final : public SoundStream {
+  AudioUnit unit = nullptr;
+  std::atomic<float> volume{1.0f};
+  static OSStatus Render(void* context, AudioUnitRenderActionFlags*,
+                         const AudioTimeStamp*, UInt32, UInt32 frames,
+                         AudioBufferList* output) {
+    auto& self = *static_cast<IOSSoundStream*>(context);
+    if (!output || output->mNumberBuffers != 1 || !output->mBuffers[0].mData ||
+        output->mBuffers[0].mDataByteSize < frames * 4) return kAudio_ParamError;
+    auto* samples = static_cast<short*>(output->mBuffers[0].mData);
+    self.m_mixer->Mix(samples, frames);
+    const float gain = self.volume.load(std::memory_order_relaxed);
+    for (UInt32 i = 0; i < frames * 2; ++i) samples[i] = static_cast<short>(samples[i] * gain);
+    return noErr;
+  }
+public:
+  ~IOSSoundStream() override {
+    if (unit) { AudioOutputUnitStop(unit); AudioUnitUninitialize(unit); AudioComponentInstanceDispose(unit); }
+  }
+  bool Init() override {
+    AudioComponentDescription description{};
+    description.componentType = kAudioUnitType_Output;
+    description.componentSubType = kAudioUnitSubType_RemoteIO;
+    description.componentManufacturer = kAudioUnitManufacturer_Apple;
+    auto component = AudioComponentFindNext(nullptr, &description);
+    if (!component || AudioComponentInstanceNew(component, &unit) != noErr) return false;
+    AudioStreamBasicDescription format{};
+    format.mSampleRate = 48000;
+    format.mFormatID = kAudioFormatLinearPCM;
+    format.mFormatFlags = kAudioFormatFlagIsSignedInteger | kAudioFormatFlagIsPacked;
+    format.mFramesPerPacket = 1;
+    format.mChannelsPerFrame = 2;
+    format.mBitsPerChannel = 16;
+    format.mBytesPerPacket = format.mBytesPerFrame = 4;
+    if (AudioUnitSetProperty(unit, kAudioUnitProperty_StreamFormat, kAudioUnitScope_Input,
+                             0, &format, sizeof(format)) != noErr) return false;
+    AURenderCallbackStruct callback{Render, this};
+    if (AudioUnitSetProperty(unit, kAudioUnitProperty_SetRenderCallback, kAudioUnitScope_Input,
+                             0, &callback, sizeof(callback)) != noErr) return false;
+    return AudioUnitInitialize(unit) == noErr;
+  }
+  bool SetRunning(bool running) override {
+    return unit && (running ? AudioOutputUnitStart(unit) : AudioOutputUnitStop(unit)) == noErr;
+  }
+  void SetVolume(int value) override { volume.store(std::clamp(value, 0, 100) / 100.0f); }
+};
+}
+std::unique_ptr<SoundStream> CreateIOSSoundStream() { return std::make_unique<IOSSoundStream>(); }
+}
diff --git a/Source/Core/Common/CursorAutoHide.h b/Source/Core/Common/CursorAutoHide.h
new file mode 100644
index 0000000..a0253c1
--- /dev/null
+++ b/Source/Core/Common/CursorAutoHide.h
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <chrono>
+
+namespace Common
+{
+// Window-local policy. Losing focus/leaving the render area always restores
+// the pointer; re-entry and physical mouse activity start a fresh grace period.
+class CursorAutoHide
+{
+public:
+  using Clock = std::chrono::steady_clock;
+  bool Update(Clock::time_point now, bool eligible, bool activity)
+  {
+    if (!eligible)
+    {
+      m_active = false;
+      return false;
+    }
+    if (!m_active || activity)
+    {
+      m_active = true;
+      m_last_activity = now;
+    }
+    return now - m_last_activity >= std::chrono::seconds(3);
+  }
+
+private:
+  Clock::time_point m_last_activity{};
+  bool m_active = false;
+};
+}  // namespace Common
diff --git a/Source/Core/Core/PowerPC/StaticRecomp/TurbulenceIdleWait.h b/Source/Core/Core/PowerPC/StaticRecomp/TurbulenceIdleWait.h
new file mode 100644
index 0000000..5479573
--- /dev/null
+++ b/Source/Core/Core/PowerPC/StaticRecomp/TurbulenceIdleWait.h
@@ -0,0 +1,23 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <array>
+#include <cstdint>
+#include <string_view>
+
+namespace TurbulenceIdleWait
+{
+constexpr std::uint32_t Address = 0x80010574;
+constexpr std::uint32_t QueueOffset = 0xffff8438; // -31688(r13), SDK ready queue bitmap
+constexpr std::array<std::uint32_t, 3> Instructions{0x800d8438, 0x28000000, 0x4182fff8};
+
+// Skip only an unchanged, interruptible scheduler idle poll with no runnable
+// threads and no exception already waiting for delivery. CoreTiming::Idle
+// advances to the next event, which can make a thread runnable again.
+inline bool CanAdvance(std::string_view game, std::uint32_t pc, std::uint32_t msr,
+                       std::uint32_t pending, std::uint32_t ready,
+                       const std::array<std::uint32_t, 3>& instructions)
+{
+  return game == "GXEE8P" && pc == Address && (msr & 0x8000) != 0 &&
+         pending == 0 && ready == 0 && instructions == Instructions;
+}
+}  // namespace TurbulenceIdleWait
diff --git a/Source/Core/VideoBackends/Metal/MTLFXScaler.h b/Source/Core/VideoBackends/Metal/MTLFXScaler.h
new file mode 100644
index 0000000..e39bb54
--- /dev/null
+++ b/Source/Core/VideoBackends/Metal/MTLFXScaler.h
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <Metal/Metal.h>
+#include <memory>
+namespace Metal {
+// Render-thread-only owner. Encodes crop + spatial upscale on the caller's
+// command buffer, preserving ordering with game drawing and presentation.
+class FXSpatialScaler {
+public:
+  FXSpatialScaler();
+  ~FXSpatialScaler();
+  static bool Supported(id<MTLDevice> device);
+  id<MTLTexture> Encode(id<MTLDevice> device, id<MTLCommandBuffer> command,
+                       id<MTLTexture> source, unsigned x, unsigned y,
+                       unsigned width, unsigned height, unsigned output_width,
+                       unsigned output_height);
+  void Reset();
+private:
+  struct Impl;
+  std::unique_ptr<Impl> m_impl;
+};
+}
diff --git a/Source/Core/VideoBackends/Metal/MTLFXScaler.mm b/Source/Core/VideoBackends/Metal/MTLFXScaler.mm
new file mode 100644
index 0000000..70f30d3
--- /dev/null
+++ b/Source/Core/VideoBackends/Metal/MTLFXScaler.mm
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "MTLFXScaler.h"
+#include "MRCHelpers.h"
+#import <MetalFX/MetalFX.h>
+namespace Metal {
+struct FXSpatialScaler::Impl {
+  MRCOwned<id> scaler;
+  MRCOwned<id<MTLTexture>> input, output, array_view;
+  id<MTLDevice> device = nil;
+  unsigned width = 0, height = 0, out_width = 0, out_height = 0;
+  MTLPixelFormat format = MTLPixelFormatInvalid;
+};
+FXSpatialScaler::FXSpatialScaler() : m_impl(std::make_unique<Impl>()) {}
+FXSpatialScaler::~FXSpatialScaler() = default;
+void FXSpatialScaler::Reset() { m_impl = std::make_unique<Impl>(); }
+bool FXSpatialScaler::Supported(id<MTLDevice> device) {
+  if (@available(iOS 16.0, macOS 13.0, *))
+    return device && [MTLFXSpatialScalerDescriptor supportsDevice:device];
+  return false;
+}
+id<MTLTexture> FXSpatialScaler::Encode(id<MTLDevice> device, id<MTLCommandBuffer> command,
+                                     id<MTLTexture> source, unsigned x, unsigned y,
+                                     unsigned width, unsigned height,
+                                     unsigned output_width, unsigned output_height) {
+  if (!Supported(device) || !command || !source || !width || !height ||
+      !output_width || !output_height || x > source.width || y > source.height ||
+      width > source.width-x || height > source.height-y || source.sampleCount != 1 ||
+      output_width < width || output_height < height) return nil;
+  if (@available(iOS 16.0, macOS 13.0, *)) {
+    auto& state = *m_impl;
+    const auto format = source.pixelFormat;
+    if (!state.scaler || state.device != device || state.width != width || state.height != height ||
+        state.out_width != output_width || state.out_height != output_height || state.format != format) {
+      Reset();
+      auto descriptor = MRCTransfer([MTLFXSpatialScalerDescriptor new]);
+      descriptor.Get().inputWidth = width; descriptor.Get().inputHeight = height;
+      descriptor.Get().outputWidth = output_width; descriptor.Get().outputHeight = output_height;
+      descriptor.Get().colorTextureFormat = format; descriptor.Get().outputTextureFormat = format;
+      descriptor.Get().colorProcessingMode = MTLFXSpatialScalerColorProcessingModePerceptual;
+      auto scaler = MRCTransfer([descriptor newSpatialScalerWithDevice:device]);
+      if (!scaler) return nil;
+      auto texture = MRCTransfer([MTLTextureDescriptor new]);
+      texture.Get().textureType = MTLTextureType2D;
+      texture.Get().pixelFormat = format;
+      texture.Get().storageMode = MTLStorageModePrivate;
+      texture.Get().width = width; texture.Get().height = height;
+      texture.Get().usage = scaler.Get().colorTextureUsage | MTLTextureUsageShaderRead;
+      auto input = MRCTransfer([device newTextureWithDescriptor:texture]);
+      texture.Get().width = output_width; texture.Get().height = output_height;
+      texture.Get().usage = scaler.Get().outputTextureUsage | MTLTextureUsageShaderRead | MTLTextureUsagePixelFormatView;
+      auto output = MRCTransfer([device newTextureWithDescriptor:texture]);
+      if (!input || !output) return nil;
+      auto view = MRCTransfer([output newTextureViewWithPixelFormat:format
+          textureType:MTLTextureType2DArray levels:NSMakeRange(0,1) slices:NSMakeRange(0,1)]);
+      if (!view) return nil;
+      input.Get().label = @"ReFare MetalFX cropped input";
+      output.Get().label = @"ReFare MetalFX spatial output";
+      m_impl->scaler = MRCRetain((id)scaler.Get());
+      m_impl->input = std::move(input); m_impl->output = std::move(output);
+      m_impl->array_view = std::move(view); m_impl->device = device;
+      m_impl->width = width; m_impl->height = height;
+      m_impl->out_width = output_width; m_impl->out_height = output_height; m_impl->format = format;
+    }
+    auto blit = [command blitCommandEncoder];
+    if (!blit) return nil;
+    [blit copyFromTexture:source sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(x,y,0)
+               sourceSize:MTLSizeMake(width,height,1) toTexture:m_impl->input
+         destinationSlice:0 destinationLevel:0 destinationOrigin:MTLOriginMake(0,0,0)];
+    [blit endEncoding];
+    id<MTLFXSpatialScaler> scaler = m_impl->scaler.Get();
+    scaler.colorTexture = m_impl->input; scaler.outputTexture = m_impl->output;
+    scaler.inputContentWidth = width; scaler.inputContentHeight = height;
+    [scaler encodeToCommandBuffer:command];
+    return m_impl->array_view;
+  }
+  return nil;
+}
+}
diff --git a/Source/Core/VideoBackends/Metal/MTLSpatialUpscaler.mm b/Source/Core/VideoBackends/Metal/MTLSpatialUpscaler.mm
new file mode 100644
index 0000000..95d4388
--- /dev/null
+++ b/Source/Core/VideoBackends/Metal/MTLSpatialUpscaler.mm
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "VideoCommon/TurbulenceMetalFX.h"
+#include "VideoBackends/Metal/MTLFXScaler.h"
+#include "VideoBackends/Metal/MTLTexture.h"
+#include "VideoBackends/Metal/MTLObjectCache.h"
+#include "VideoBackends/Metal/MTLStateTracker.h"
+#include "Common/Config/Config.h"
+#include "Core/Config/GraphicsSettings.h"
+#include <atomic>
+#include <cstdio>
+namespace TurbulenceMetalFX {
+namespace {
+std::atomic<Support> support{Support::NotReady};
+std::unique_ptr<Metal::FXSpatialScaler> scaler;
+std::unique_ptr<Metal::Texture> result;
+}
+Support GetSupport() { return support.load(); }
+void Initialize() {
+  result.reset(); scaler.reset();
+  support = Metal::FXSpatialScaler::Supported(Metal::g_device) ? Support::Available : Support::Unavailable;
+  std::fprintf(stderr,"[MetalFX] spatial upscaling %s\n",GetSupport() == Support::Available ? "available" : "unavailable on this OS/GPU");
+}
+void Shutdown() { result.reset(); scaler.reset(); support = Support::NotReady; }
+const AbstractTexture* Upscale(const AbstractTexture* source, const MathUtil::Rectangle<int>& region,
+                              unsigned width, unsigned height) {
+  if (!Config::Get(Config::GFX_METALFX_SPATIAL)) { result.reset(); scaler.reset(); return nullptr; }
+  if (GetSupport() != Support::Available || !source || source->GetLayers() != 1 ||
+      region.left < 0 || region.top < 0 || region.GetWidth() <= 0 || region.GetHeight() <= 0 ||
+      width < static_cast<unsigned>(region.GetWidth()) || height < static_cast<unsigned>(region.GetHeight()) ||
+      (width == static_cast<unsigned>(region.GetWidth()) && height == static_cast<unsigned>(region.GetHeight()))) return nullptr;
+  const auto* texture = static_cast<const Metal::Texture*>(source);
+  if (!scaler) scaler = std::make_unique<Metal::FXSpatialScaler>();
+  Metal::g_state_tracker->EndRenderPass();
+  auto output = scaler->Encode(Metal::g_device, Metal::g_state_tracker->GetRenderCmdBuf(), texture->GetMTLTexture(),
+                              region.left, region.top, region.GetWidth(), region.GetHeight(), width, height);
+  if (!output) {
+    support = Support::Failed;
+    result.reset(); scaler.reset();
+    std::fprintf(stderr,"[MetalFX] scaler initialization failed; using normal presentation\n");
+    return nullptr;
+  }
+  if (!result || result->GetMTLTexture() != output) {
+    TextureConfig config(width,height,1,1,1,source->GetFormat(),0,AbstractTextureType::Texture_2DArray);
+    result = std::make_unique<Metal::Texture>(MRCRetain(output),config);
+  }
+  return result.get();
+}
+}
