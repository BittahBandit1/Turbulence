+std::map<std::pair<std::string, int>, std::shared_ptr<VideoCommon::CustomTextureData>> s_built;
+std::atomic<int> s_style{GameCube};
+std::atomic<bool> s_changed{false};
+
+bool ParseSize(const std::string& prefix, u32* width, u32* height)
+{
+  // "tex1_<W>x<H>_<hash>"
+  return std::sscanf(prefix.c_str(), "tex1_%ux%u_", width, height) == 2;
+}
+}  // namespace
+
+void Register(Recipe recipe)
+{
+  std::lock_guard lock(s_mutex);
+  s_recipes.push_back(std::move(recipe));
+}
+
+void SetStyle(Style style)
+{
+  if (s_style.exchange(style) != style)
+    s_changed.store(true);
+}
+
+bool TakeStyleChange()
+{
+  return s_changed.load(std::memory_order_relaxed) && s_changed.exchange(false);
+}
+
+bool MayMatch(u32 width, u32 height, u32 gx_format)
+{
+  std::lock_guard lock(s_mutex);
+  for (const Recipe& r : s_recipes)
+  {
+    u32 w = 0, h = 0;
+    if (ParseSize(r.name_prefix, &w, &h) && w == width && h == height && r.gx_format == gx_format)
+      return true;
+  }
+  return false;
+}
+
+std::shared_ptr<VideoCommon::CustomTextureData> Find(const TextureInfo& texture_info)
+{
+  const int style = s_style.load(std::memory_order_relaxed);
+  if (style == GameCube || !texture_info.IsDataValid())
+    return nullptr;
+  const u32 format = static_cast<u32>(texture_info.GetTextureFormat());
+  const u32 width = texture_info.GetRawWidth(), height = texture_info.GetRawHeight();
+  if (!MayMatch(width, height, format))
+    return nullptr;
+
+  const TextureInfo::NameDetails name = texture_info.CalculateTextureName();
+  const std::string prefix = Detail::RecipePrefix(name.base_name, name.texture_name);
+  const std::string full_name = name.GetFullName();
+
+  std::lock_guard lock(s_mutex);
+  const Recipe* recipe = nullptr;
+  for (const Recipe& r : s_recipes)
+  {
+    if (r.name_prefix == prefix && r.gx_format == format)
+      recipe = &r;
+  }
+  if (!recipe)
+  {
+    if (std::getenv("TURBULENCE_DUMP_UI"))
+    {
+      static std::set<std::string> reported;
+      if (reported.insert(full_name).second)
+        std::fprintf(stderr, "[turbulence] unrecognized HUD atlas: %s\n", full_name.c_str());
+    }
+    return nullptr;
+  }
+  if (auto it = s_built.find({full_name, style}); it != s_built.end())
+    return it->second;
+
+  // Decode the game's own texture (expanded to whole blocks), then copy the
+  // chosen style's cells over the GameCube cells.
+  const u32 ew = texture_info.GetExpandedWidth(), eh = texture_info.GetExpandedHeight();
+  std::vector<u8> decoded(size_t(ew) * eh * 4);
+  TexDecoder_Decode(decoded.data(), texture_info.GetData(), ew, eh,
+                    texture_info.GetTextureFormat(), texture_info.GetTlutAddress(),
+                    texture_info.GetTlutFormat());
+  std::vector<u8> rgba(size_t(width) * height * 4);
+  for (u32 y = 0; y < height; ++y)
+    std::memcpy(&rgba[size_t(y) * width * 4], &decoded[size_t(y) * ew * 4], size_t(width) * 4);
+  const char* dump_dir = std::getenv("TURBULENCE_UI_DUMP_DIR");
+  if (dump_dir && *dump_dir)
+  {
+    std::error_code ec;
+    std::filesystem::create_directories(dump_dir, ec);
+    if (!ec)
+      Common::SavePNG((std::filesystem::path(dump_dir) / ("native-" + full_name + ".png")).string(),
+                      rgba.data(), Common::ImageByteFormat::RGBA, width, height, width * 4);
+  }
+  Detail::ApplyCells(rgba, width, height, decoded, ew, *recipe, static_cast<Style>(style));
+  if (dump_dir && *dump_dir)
+    Common::SavePNG((std::filesystem::path(dump_dir) /
+                     ((style == Xbox ? "xbox-" : "playstation-") + full_name + ".png")).string(),
+                    rgba.data(), Common::ImageByteFormat::RGBA, width, height, width * 4);
+
+  auto data = std::make_shared<VideoCommon::CustomTextureData>();
+  auto& level = data->m_slices.emplace_back().m_levels.emplace_back();
+  level.width = width;
+  level.height = height;
+  level.row_length = width;
+  level.format = AbstractTextureFormat::RGBA8;
+  level.data = Common::UniqueBuffer<u8>(rgba.size());
+  std::memcpy(level.data.data(), rgba.data(), rgba.size());
+  s_built[{full_name, style}] = data;
+  std::fprintf(stderr, "[turbulence] button prompts: %s -> %s\n", full_name.c_str(),
+               style == Xbox ? "Xbox" : "PlayStation");
+  return data;
+}
+}  // namespace TurbulencePromptTextures
