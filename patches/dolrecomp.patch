         rel_free(rel);
         return false;
     }
+    /* Turbulence: OSLinkFixed places .bss wherever the game allocated it, not
+       after the file. To bake the same addresses the game computes at run
+       time, DOLRECOMP_REL_BSS can pin the .bss address (hex or decimal). */
+    {
+        const char* pinned_bss = getenv("DOLRECOMP_REL_BSS");
+        if (pinned_bss && pinned_bss[0]) {
+            char* end = NULL;
+            unsigned long value = strtoul(pinned_bss, &end, 0);
+            if (!end || *end != '\0' || value == 0 || value > 0xFFFFFFFFul) {
+                fprintf(stderr, "error: invalid DOLRECOMP_REL_BSS '%s'\n", pinned_bss);
+                rel_free(rel);
+                return false;
+            }
+            bss_cursor = (u32)value;
+        }
+    }
 
     u32 executable_count = 0;
     for (u32 i = 0; i < rel->section_count; i++) {
@@ -477,11 +493,15 @@ bool rel_load_image(RELFile* rel, const char* path, u32 base_address) {
             rel_free(rel);
             return false;
         }
+        /* Turbulence: an in-place section lives at load address + file
+           offset and OSLink never moves it, so its alignment is whatever the
+           file gives it (Sonic Riders' _Main.rel has .text at +0xBC with a
+           32-byte alignment field). Only warn. */
         if (section_alignment > 1 && executable &&
             (section->address % section_alignment) != 0) {
-            fprintf(stderr, "error: REL executable section %u is not aligned\n", i);
-            rel_free(rel);
-            return false;
+            fprintf(stderr, "warning: REL executable section %u is not %u-byte aligned "
+                    "at 0x%08X; keeping it in place\n", i, section_alignment,
+                    section->address);
         }
 
         section->owned_data = (u8*)malloc(size);
