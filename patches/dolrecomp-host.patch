+    write_be32(file + 0x58, 0x104 | 1u);
+    write_be32(file + 0x60, 0x10C);
+    write_be32(file + 0x104, 0);
+    write_be32(file + 0x108, 0x4E800020u);
+    write_be32(file + 0x10C, 0x12345678u);
