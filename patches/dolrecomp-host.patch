+namespace dolllvm {
+using namespace llvm;
+
+void FunctionEmitter::emitExactFloat(u64 descriptor) {
+  const auto op = static_cast<DolIRExactFloat>(descriptor & 0xFFu);
+  const bool fused = op >= DOLIR_EXACT_FMADDS && op <= DOLIR_EXACT_FNMSUBS;
+  const bool subtract = op == DOLIR_EXACT_FMSUBS || op == DOLIR_EXACT_FNMSUBS;
+  const bool negate = op == DOLIR_EXACT_FNMADDS || op == DOLIR_EXACT_FNMSUBS;
+  if (!fused && op != DOLIR_EXACT_FADDS && op != DOLIR_EXACT_FSUBS &&
+      op != DOLIR_EXACT_FMULS) {
+    emitExactFloatSlow(descriptor);
+    return;
+  }
+  // Ordinary normal single results need no exception/NI fixups. Keep them
+  // local to the generated function; preserve the exact runtime for all
+  // other results, including underflow, overflow and NaNs.
+  materializeFPRF();
+  const u32 d = (descriptor >> 8) & 0xFFu;
+  const u32 a = (descriptor >> 16) & 0xFFu;
+  const u32 b = (descriptor >> 24) & 0xFFu;
+  const u32 c = (descriptor >> 32) & 0xFFu;
+  const auto incomingRep = fp_rep_;
+  const auto incomingSingle = fp_exact_single_;
+  const auto incomingSafe = fp_denormal_safe_;
+  const auto incomingClass = fp_value_class_;
+  const auto incomingKnown = known_state_;
+  Value *left = stateValue(static_cast<DolIRStateSlot>(DOLIR_STATE_FPR0 + a));
+  Value *right = stateValue(static_cast<DolIRStateSlot>(
+      DOLIR_STATE_FPR0 + (op == DOLIR_EXACT_FMULS || fused ? c : b)));
+  Value *regularMultiplier = builder_.getTrue();
+  if (op == DOLIR_EXACT_FMULS || fused) {
+    Value *bits = builder_.CreateBitCast(right, builder_.getInt64Ty());
+    Value *magnitude = builder_.CreateAnd(bits, builder_.getInt64(0x7FFFFFFFFFFFFFFFull));
+    regularMultiplier = builder_.CreateOr(
+        builder_.CreateICmpEQ(magnitude, builder_.getInt64(0)),
+        builder_.CreateICmpNE(builder_.CreateAnd(bits, builder_.getInt64(0x7FF0000000000000ull)),
+                              builder_.getInt64(0)));
+    Value *rounded = builder_.CreateAdd(
+        builder_.CreateAnd(bits, builder_.getInt64(0xFFFFFFFFF8000000ull)),
+        builder_.CreateAnd(bits, builder_.getInt64(0x0000000008000000ull)));
+    right = builder_.CreateBitCast(rounded, right->getType());
+  }
+  Value *result;
+  if (fused) {
+    Value *addend = stateValue(static_cast<DolIRStateSlot>(DOLIR_STATE_FPR0 + b));
+    if (subtract)
+      addend = builder_.CreateFNeg(addend);
+    Function *fma = Intrinsic::getDeclaration(
+        &module_, Intrinsic::experimental_constrained_fma, {left->getType()});
+    result = builder_.CreateConstrainedFPCall(
+        fma, {left, right, addend}, "scalar.fma", RoundingMode::Dynamic, fp::ebIgnore);
+  } else {
+    const auto intrinsic = op == DOLIR_EXACT_FADDS ? Intrinsic::experimental_constrained_fadd :
+                           op == DOLIR_EXACT_FSUBS ? Intrinsic::experimental_constrained_fsub :
+                                                    Intrinsic::experimental_constrained_fmul;
+    result = builder_.CreateConstrainedFPBinOp(
+        intrinsic, left, right, nullptr, "scalar.math", nullptr,
+        RoundingMode::Dynamic, fp::ebIgnore);
+  }
+  Value *bits = builder_.CreateBitCast(result, builder_.getInt64Ty());
+  Value *magnitude = builder_.CreateAnd(bits, builder_.getInt64(0x7FFFFFFFFFFFFFFFull));
+  Value *normal = builder_.CreateAnd(
+      builder_.CreateICmpUGE(magnitude, builder_.getInt64(0x3810000000000000ull)),
+      builder_.CreateICmpULE(magnitude, builder_.getInt64(0x47EFFFFFE0000000ull)));
+  if (fused) {
+    // The runtime corrects rare double-rounding ties before single rounding.
+    // Those cases retain the full helper, as do special multiplier operands.
+    Value *notTie = builder_.CreateICmpNE(
+        builder_.CreateAnd(bits, builder_.getInt64(0x000000001FFFFFFFull)),
+        builder_.getInt64(0x0000000010000000ull));
+    Value *originalC = stateValue(static_cast<DolIRStateSlot>(DOLIR_STATE_FPR0 + c));
+    Value *cBits = builder_.CreateBitCast(originalC, builder_.getInt64Ty());
+    Value *finiteC = builder_.CreateICmpNE(
+        builder_.CreateAnd(cBits, builder_.getInt64(0x7FF0000000000000ull)),
+        builder_.getInt64(0x7FF0000000000000ull));
+    normal = builder_.CreateAnd(normal, builder_.CreateAnd(notTie, finiteC));
+  }
+  BasicBlock *fast = BasicBlock::Create(context_, "scalar_normal", function_);
+  BasicBlock *slow = BasicBlock::Create(context_, "scalar_exact", function_);
+  BasicBlock *join = BasicBlock::Create(context_, "scalar_join", function_);
+  builder_.CreateCondBr(builder_.CreateAnd(normal, regularMultiplier), fast, slow,
+                        MDBuilder(context_).createBranchWeights(2000, 1));
+  builder_.SetInsertPoint(fast);
+  Value *single = builder_.CreateConstrainedFPCast(
+      Intrinsic::experimental_constrained_fptrunc, result, builder_.getFloatTy(),
+      nullptr, "scalar.round", nullptr, RoundingMode::Dynamic, fp::ebIgnore);
+  if (negate) {
+    single = builder_.CreateFNeg(single);
+    bits = builder_.CreateXor(bits, builder_.getInt64(0x8000000000000000ull));
+  }
+  Value *pair = PoisonValue::get(FixedVectorType::get(builder_.getFloatTy(), 2));
+  pair = builder_.CreateInsertElement(pair, single, uint64_t{0});
+  pair = builder_.CreateInsertElement(pair, single, 1u);
+  writePairF32(d, pair, true, FPValueClass::Finite);
+  Value *fpscr = builder_.CreateLoad(builder_.getInt32Ty(), state_[DOLIR_STATE_FPSCR]);
+  u32 clear = 0x1Fu << 12;
+  if (op == DOLIR_EXACT_FMULS)
+    clear |= 0x00020000u | 0x00040000u;  // FI / FR
+  Value *negative = builder_.CreateICmpNE(
+      builder_.CreateAnd(bits, builder_.getInt64(0x8000000000000000ull)), builder_.getInt64(0));
+  Value *classification = builder_.CreateSelect(negative, builder_.getInt32(0x08u << 12),
+                                                         builder_.getInt32(0x04u << 12));
+  builder_.CreateStore(builder_.CreateOr(
+      builder_.CreateAnd(fpscr, builder_.getInt32(~clear)), classification),
+      state_[DOLIR_STATE_FPSCR]);
+  builder_.CreateBr(join);
+
+  builder_.SetInsertPoint(slow);
+  fp_rep_ = incomingRep;
+  fp_exact_single_ = incomingSingle;
+  fp_denormal_safe_ = incomingSafe;
+  fp_value_class_ = incomingClass;
+  known_state_ = incomingKnown;
+  emitExactFloatSlow(descriptor);
+  builder_.CreateBr(join);
+  builder_.SetInsertPoint(join);
+  known_state_[DOLIR_STATE_FPSCR] = nullptr;
+  fp_rep_[d] = FPRepresentation::PairF32;
+  fp_exact_single_[d] = true;
+  fp_denormal_safe_[d] = true;
+  fp_value_class_[d] = FPValueClass::Unknown;
+}
