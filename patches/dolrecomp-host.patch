+    write_be32(field, 0);
+    CHECK(fseek(f, 0x60, SEEK_SET) == 0 && fwrite(field, 1, 4, f) == 4, "failed to write BSS section");
+    fclose(f);
+    const char* old = getenv("DOLRECOMP_REL_BSS");
+    char* saved = old ? malloc(strlen(old) + 1) : NULL;
