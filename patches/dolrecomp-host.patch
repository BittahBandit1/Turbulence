+/* DOLRECOMP_LLVM_FUNCTION_CHUNKS=1 aligns LLVM chunk boundaries with guest
+ * function starts instead of cutting every N instructions. Fixed-size chunks
+ * split hot functions (and the loops inside them) across native functions, so
+ * every iteration pays cross-chunk call/budget/state-sync costs. */
+static int llvm_function_chunks_enabled(void) {
+    const char* configured = getenv("DOLRECOMP_LLVM_FUNCTION_CHUNKS");
+    return configured && !strcmp(configured, "1");
+}
