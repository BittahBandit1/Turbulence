+static u32 llvm_function_chunk_max(u32 minimum) {
+    const char* configured = getenv("DOLRECOMP_LLVM_FUNCTION_CHUNK_MAX");
+    unsigned long value = 1024u;
+    if (configured && configured[0]) {
+        char* end = NULL;
+        errno = 0;
+        value = strtoul(configured, &end, 10);
+        if (errno || !end || *end || value < 128u || value > 4096u) {
+            fprintf(stderr,
+                    "warning: DOLRECOMP_LLVM_FUNCTION_CHUNK_MAX must be "
+                    "128..4096; using 1024\n");
+            value = 1024u;
+        }
+    }
+    return value < minimum ? minimum : (u32)value;
+}
