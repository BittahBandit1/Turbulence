+                  read_be32(rel.sections[1].data) == 0x80600000u, "pinned BSS relocation is wrong");
+            rel_free(&rel);
+        }
+    }
+    CHECK(set_bss_environment(saved) == 0, "failed to restore BSS environment");
+    free(saved);
