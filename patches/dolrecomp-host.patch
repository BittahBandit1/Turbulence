+/* Function starts: program entry, symbols, bl targets and stwu r1 prologues. */
+static u32* collect_llvm_function_starts(const LoadedCodeSection* sections,
+                                         u32 section_count, u32 program_entry,
+                                         const DolRecompSymbolMap* symbols,
+                                         u32* result_count) {
+    size_t capacity = 1u + (symbols ? symbols->count : 0u);
+    for (u32 i = 0; i < section_count; i++)
+        capacity += sections[i].size / 4u * 2u;
+    u32* points = (u32*)malloc(capacity * sizeof(*points));
+    if (!points)
+        return NULL;
+    u32 count = 0;
+    if (llvm_code_address(sections, section_count, program_entry))
+        points[count++] = program_entry;
+    if (symbols) {
+        for (u32 i = 0; i < symbols->count; i++) {
+            u32 address = symbols->symbols[i].address;
+            if (llvm_code_address(sections, section_count, address))
+                points[count++] = address;
+        }
+    }
+    for (u32 section_index = 0; section_index < section_count;
+         section_index++) {
+        const LoadedCodeSection* section = &sections[section_index];
+        for (u32 offset = 0; section->data && offset + 4u <= section->size;
+             offset += 4u) {
+            u32 address = section->address + offset;
+            u32 raw = read_be32(section->data + offset);
+            if ((raw >> 16) == 0x9421u) /* stwu r1, -N(r1) */
+                points[count++] = address;
+            PPCInst inst = ppc_decode(raw, address);
+            if ((inst.op == PPC_OP_B || inst.op == PPC_OP_BC) && inst.lk &&
+                llvm_code_address(sections, section_count, inst.branch_target))
+                points[count++] = inst.branch_target;
+        }
+    }
+    qsort(points, count, sizeof(*points), compare_u32);
+    u32 unique = 0;
+    for (u32 i = 0; i < count; i++) {
+        if (!unique || points[i] != points[unique - 1u])
+            points[unique++] = points[i];
+    }
+    *result_count = unique;
+    return points;
+}
+
+/* Index of the first value >= address, or count. */
+static u32 lower_bound_u32(const u32* values, u32 count, u32 address) {
+    u32 lo = 0, hi = count;
+    while (lo < hi) {
+        u32 mid = lo + (hi - lo) / 2u;
+        if (values[mid] < address)
+            lo = mid + 1u;
+        else
+            hi = mid;
+    }
+    return lo;
+}
+
+static LLVMPartition* partition_llvm_section(const LoadedCodeSection* section,
+                                             u32 chunk_instructions,
+                                             int function_chunks, u32 maximum,
+                                             const u32* starts,
+                                             u32 start_count,
+                                             u32* result_count) {
+    const u32 n = section->size / 4u;
+    LLVMPartition* parts =
+        (LLVMPartition*)malloc(((size_t)n + 1u) * sizeof(*parts));
+    if (!parts)
+        return NULL;
+    u32 count = 0;
+    u32 s = 0;
+    while (s < n) {
+        u32 cut;
+        if (!function_chunks) {
+            cut = n - s > chunk_instructions ? s + chunk_instructions : n;
+        } else {
+            const u32 target = s + chunk_instructions;
+            const u32 limit = n - s > maximum ? s + maximum : n;
+            if (target >= n) {
+                cut = n;
+            } else {
+                u32 first = lower_bound_u32(starts, start_count,
+                                            section->address + target * 4u);
+                u32 first_index =
+                    first < start_count && starts[first] >= section->address
+                        ? (starts[first] - section->address) / 4u
+                        : n + 1u;
+                if (first_index < n && first_index <= limit) {
+                    cut = first_index;
+                } else if (limit == n) {
+                    cut = n;
+                } else {
+                    /* Nothing to cut at before the size cap: start the big
+                     * function at its own chunk boundary if it began after s. */
+                    cut = limit;
+                    if (first > 0u &&
+                        starts[first - 1u] > section->address + s * 4u)
+                        cut = (starts[first - 1u] - section->address) / 4u;
+                }
+            }
+        }
+        parts[count].start = s;
+        parts[count].count = cut - s;
+        count++;
+        s = cut;
+    }
+    *result_count = count;
+    return parts;
+}
