+// Turbulence: a crash on Windows otherwise exits silently. Report the
+// exception and the module + offset it happened in, so a tester can paste it.
+LONG WINAPI ReportUnhandledException(EXCEPTION_POINTERS *info) {
+  const EXCEPTION_RECORD *record = info->ExceptionRecord;
+  const void *address = record->ExceptionAddress;
+  char module_path[MAX_PATH] = "?";
+  HMODULE module = nullptr;
+  uintptr_t offset = 0;
+  if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                             GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                         static_cast<LPCSTR>(address), &module) &&
+      module) {
+    GetModuleFileNameA(module, module_path, MAX_PATH);
+    offset = reinterpret_cast<uintptr_t>(address) - reinterpret_cast<uintptr_t>(module);
+  }
+  const char *name = std::strrchr(module_path, '\\');
+  std::fprintf(stderr, "\n[crash] exception 0x%08lX at %p (%s+0x%llX)",
+               static_cast<unsigned long>(record->ExceptionCode), address,
+               name ? name + 1 : module_path, static_cast<unsigned long long>(offset));
+  if (record->ExceptionCode == EXCEPTION_ACCESS_VIOLATION && record->NumberParameters >= 2)
+    std::fprintf(stderr, " %s 0x%llX",
+                 record->ExceptionInformation[0] == 0   ? "reading"
+                 : record->ExceptionInformation[0] == 8 ? "executing"
+                                                        : "writing",
+                 static_cast<unsigned long long>(record->ExceptionInformation[1]));
+  std::fprintf(stderr, "\n");
+  // MSVC C++ exception: [1] thrown object, [2] ThrowInfo, [3] image base (x64
+  // RVAs). Print the catchable type names and std::exception::what().
+  if (record->ExceptionCode == 0xE06D7363 && record->NumberParameters >= 4 &&
+      record->ExceptionInformation[2] && record->ExceptionInformation[3]) {
+    const auto base = static_cast<uintptr_t>(record->ExceptionInformation[3]);
+    const auto *object = reinterpret_cast<const char *>(record->ExceptionInformation[1]);
+    const auto *throw_info = reinterpret_cast<const int32_t *>(record->ExceptionInformation[2]);
+    const auto *types = reinterpret_cast<const int32_t *>(base + static_cast<uint32_t>(throw_info[3]));
+    for (int32_t i = 0; i < types[0] && i < 16; ++i) {
+      const auto *type = reinterpret_cast<const int32_t *>(base + static_cast<uint32_t>(types[1 + i]));
+      const char *name = reinterpret_cast<const char *>(base + static_cast<uint32_t>(type[1])) +
+                         2 * sizeof(void *);
+      std::fprintf(stderr, "[crash]   type %s\n", name);
+      if (object && std::strcmp(name, ".?AVexception@std@@") == 0 && type[3] < 0)
+        std::fprintf(stderr, "[crash]   what(): %s\n",
+                     reinterpret_cast<const std::exception *>(object + type[2])->what());
+    }
+  }
+  void *frames[48];
+  const USHORT count = RtlCaptureStackBackTrace(0, 48, frames, nullptr);
+  for (USHORT i = 0; i < count; ++i) {
+    char frame_module[MAX_PATH] = "?";
+    HMODULE frame_handle = nullptr;
+    uintptr_t frame_offset = reinterpret_cast<uintptr_t>(frames[i]);
+    if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                               GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                           static_cast<LPCSTR>(frames[i]), &frame_handle) &&
+        frame_handle) {
+      GetModuleFileNameA(frame_handle, frame_module, MAX_PATH);
+      frame_offset -= reinterpret_cast<uintptr_t>(frame_handle);
+    }
+    const char *frame_name = std::strrchr(frame_module, '\\');
+    std::fprintf(stderr, "[crash]   #%u %s+0x%llX\n", i, frame_name ? frame_name + 1 : frame_module,
+                 static_cast<unsigned long long>(frame_offset));
+  }
+  std::fflush(stderr);
+  return EXCEPTION_CONTINUE_SEARCH;
+}
