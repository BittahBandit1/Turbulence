+                         "%-22s", kResOptions[res_idx].label);
+      ImGui::SameLine();
+      if (ImGui::Button(">##res"))
+      {
+        s_selected_row = 0;
+        ApplyResIdx(res_idx + 1);
+      }
+
+      // Row 1: Aspect Ratio
+      DrawRowPrefix(1, "Aspect Ratio:");
+      if (ImGui::Button("<##asp"))
+      {
+        s_selected_row = 1;
+        ApplyAspectIdx(aspect_idx - 1);
+      }
+      ImGui::SameLine();
+      ImGui::TextColored(s_selected_row == 1 ? ImVec4(1.0f, 0.9f, 0.3f, 1.0f) :
+                                               ImVec4(0.9f, 0.95f, 1.0f, 1.0f),
+                         "%-22s", kAspectOptions[aspect_idx].label);
+      ImGui::SameLine();
+      if (ImGui::Button(">##asp"))
+      {
+        s_selected_row = 1;
+        ApplyAspectIdx(aspect_idx + 1);
+      }
+
+      // Row 2: HUD Aspect Mode
+      DrawRowPrefix(2, "HUD Layout:");
+      if (ImGui::Button("<##hud"))
+      {
+        s_selected_row = 2;
+        g_turbulence_hud_stretched = !g_turbulence_hud_stretched;
+        Core::System::GetInstance().GetVertexShaderManager().dirty = true;
+      }
+      ImGui::SameLine();
+      ImGui::TextColored(s_selected_row == 2 ? ImVec4(1.0f, 0.9f, 0.3f, 1.0f) :
+                                               ImVec4(0.9f, 0.95f, 1.0f, 1.0f),
+                         "%-22s",
+                         g_turbulence_hud_stretched ? "Stretched (16:9)" : "Centered (4:3)");
+      ImGui::SameLine();
+      if (ImGui::Button(">##hud"))
+      {
+        s_selected_row = 2;
+        g_turbulence_hud_stretched = !g_turbulence_hud_stretched;
+        Core::System::GetInstance().GetVertexShaderManager().dirty = true;
+      }
+
+      // Row 3: Metal Performance HUD
+      DrawRowPrefix(3, "Metal HUD:");
+      if (ImGui::Button("<##mhud"))
+      {
+        s_selected_row = 3;
+        g_turbulence_metal_hud_enabled = !g_turbulence_metal_hud_enabled;
+      }
+      ImGui::SameLine();
+      ImGui::TextColored(g_turbulence_metal_hud_enabled ? ImVec4(0.35f, 1.0f, 0.55f, 1.0f) :
+                                                          ImVec4(0.85f, 0.45f, 0.45f, 1.0f),
+                         "%-22s", g_turbulence_metal_hud_enabled ? "Enabled (On)" : "Disabled (Off)");
+      ImGui::SameLine();
+      if (ImGui::Button(">##mhud"))
+      {
+        s_selected_row = 3;
+        g_turbulence_metal_hud_enabled = !g_turbulence_metal_hud_enabled;
+      }
+
+      ImGui::Separator();
+
+      // Row 4: Exit Game
+      DrawRowPrefix(4, "Exit Game:");
+      if (s_selected_row == 4)
+      {
+        ImGui::PushStyleColor(ImGuiCol_Button, ImVec4(0.75f, 0.18f, 0.18f, 1.0f));
+        ImGui::PushStyleColor(ImGuiCol_ButtonHovered, ImVec4(0.90f, 0.25f, 0.25f, 1.0f));
+      }
+      if (ImGui::Button(s_selected_row == 4 ? "> Exit Game <" : "  Exit Game  ",
+                        ImVec2(230.0f * scale, 30.0f * scale)))
+      {
+        s_selected_row = 4;
+        s_confirm_exit_open = true;
+        s_confirm_exit_choice = 0;  // Default to No (Left)
+      }
+      if (s_selected_row == 4)
+        ImGui::PopStyleColor(2);
+    }
+  }
+  ImGui::End();
+
+  ImGui::PopStyleVar(3);
+  ImGui::PopStyleColor(2);
+}
