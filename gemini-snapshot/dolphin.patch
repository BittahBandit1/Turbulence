+bool PollAnyDeviceInput(std::string_view input_name, double threshold = 0.5)
+{
+  if (!Host_RendererHasFocus() || !g_controller_interface.IsInit())
+    return false;
+  for (const auto& dev : g_controller_interface.GetAllDevices())
+  {
+    if (!dev)
+      continue;
+    if (auto* inp = dev->FindInput(input_name))
+    {
+      if (inp->GetState() > threshold)
+        return true;
+    }
+  }
+  return false;
+}
