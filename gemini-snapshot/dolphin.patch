+      ImGui::Spacing();
+      ImGui::TextColored(ImVec4(1.0f, 0.85f, 0.25f, 1.0f), "Are you sure?");
+      ImGui::TextColored(ImVec4(0.75f, 0.85f, 0.95f, 1.0f),
